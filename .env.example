# M1 browser demo needs no Supabase configuration.
# M2 opt-in online accounts: these values are provided by YOUR Supabase project.
# Configure both in Vercel Project → Settings → Environment Variables.
# URL and publishable key are safe for public browser access ONLY WITH RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never commit a secret key, legacy service_role, DATABASE_URL or access token.
# After configuring production values, trigger a new production build.
